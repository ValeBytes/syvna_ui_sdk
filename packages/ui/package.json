{
  "name": "@syvna/ui",
  "version": "0.5.0",
  "description": "Syvna's components: what apps' screens are built from, themed by a room's design through CSS variables.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./tokens.json",
    "./catalogue.json": "./catalogue.json",
    "./docs/*": "./docs/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs --tokens-only",
    "canvas": "python scripts/previews.py && node scripts/build.mjs && node scripts/canvas.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/react": "^19",
    "esbuild": "0.25.10",
    "react": "19.3.0",
    "tailwindcss": "4.1.13",
    "typescript": "^5"
  },
  "dependencies": {
    "tailwind-merge": "3.3.1"
  },
  "files": [
    "src",
    "tokens.json",
    "catalogue.json",
    "docs"
  ]
}
